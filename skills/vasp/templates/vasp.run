#!/bin/bash
# Generic VASP job script template for tools4vasp.vaspsetup.patch_runscript().
# The three directives tools4vasp requires everywhere are active below; the
# per-machine blocks are commented out. Uncomment exactly one of them.
#SBATCH --job-name=vasp-run
#SBATCH --output=slurm-vasp-run-%j.out #descriptive name + job id; stderr merges in, as with SLURM's default
#SBATCH --mail-type=ALL
#SBATCH --mail-user=CHANGE-ME@example.org
#SBATCH -t 02:00:00
#SBATCH --nodes=1
#SBATCH --exclusive
#SBATCH --signal=B:12@600 #signal 12 to the batch script 10 min before the kill

##ZIH (TU Dresden) -- Barnard, Capella
##SBATCH -A CHANGE-ME #project
##SBATCH -p barnard #barnard, capella
##SBATCH --licenses=horse #FILESYSTEM INTERLOCK: /data/horse=horse, /data/walrus=walrus, Capella=cat. Without it the job can start while the file system is in maintenance and lose the whole walltime
##SBATCH --ntasks-per-node=48 #must satisfy NCORE * KPAR | (nodes * ntasks-per-node)
##SBATCH --mem=0 #all the memory on an exclusive node

##PC2 Noctua2
##SBATCH -A CHANGE-ME
##SBATCH -p normal #normal, largemem, hugemem, gpu
##SBATCH --ntasks-per-node=128
##SBATCH --mem=0

# ---------------------------------------------------------------------------
# Pre-flight: refuse to burn walltime on a directory that fails its own checks.
# The gate travels with the calculation instead of living only in the submitting
# agent's harness (council 2026-09-02). Errors abort; a missing checker warns
# and continues, so a dependency problem never costs a queued job.
# Drop a copy of the INCAR template next to the INCAR to have the
# undeclared-deviation check run here too; vasplint searches the run directory.
# ---------------------------------------------------------------------------
if command -v vasplint >/dev/null 2>&1; then
    vasplint --site zih "${PWD}" || { echo "vasplint rejected these inputs, aborting before VASP starts" >&2; exit 1; }
elif python3 -c "import tools4vasp.vasplint" >/dev/null 2>&1; then
    python3 -m tools4vasp.vasplint --site zih "${PWD}" || { echo "vasplint rejected these inputs, aborting before VASP starts" >&2; exit 1; }
else
    echo "WARNING: vasplint not found, inputs were NOT checked on the compute node" >&2
fi

module purge
# module load <your VASP module>

STDIN=""   #interactive mode (IBRION=11) reads structures 2..N from this file

if [ -n "${STDIN}" ]; then
    srun vasp_std < "${STDIN}"
else
    srun vasp_std
fi
